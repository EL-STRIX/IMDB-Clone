# ==========================================
# IMDb Clone Environment Configuration
# ==========================================

# TMDb API Key (v3) - Required for movie, actor, search, and trailer discovery
# Obtain free at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Key - Used for Rotten Tomatoes and Metacritic rating streams
# Obtain free at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Revalidation Secret - Protects on-demand ISR revalidation endpoints
# (e.g., /api/revalidate, /api/revalidate/actor)
REVALIDATE_SECRET=your_secret_token_here

# Session Secret (Optional) - Used for HMAC-SHA256 session token signatures
# Defaults to internal derivation if not provided
SESSION_SECRET=your_session_hmac_secret_here
